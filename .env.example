# MediaGram (BeeSocial) Environment Variables Example
# Copy this file to .env.local for local development or configure these in Vercel Project Settings

# Cloudinary Credentials (Required for Media Storage, Signed Direct Ingestion & AI)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# NextAuth / App URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret"

# Optional Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/beesocial?sslmode=require"
